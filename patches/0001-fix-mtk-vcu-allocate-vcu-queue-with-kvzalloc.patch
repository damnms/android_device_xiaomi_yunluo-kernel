From 6817d51ccd46ad2756c6634d7476a7affc21875f Mon Sep 17 00:00:00 2001
From: damnms <40913090+damnms@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:13:49 +0100
Subject: [PATCH] fix(mtk-vcu): allocate vcu queue with kvzalloc

struct mtk_vcu_queue holds three arrays of CODEC_MAX_BUFFER (768)
buffer descriptors and is about 123 KB large. mtk_vcu_mem_init()
allocates it with kzalloc() on every open of the VCU device, i.e. for
every new video decoder or encoder instance. kzalloc() needs a
physically contiguous order-5 (128 KB) block.

On the 3 GB Redmi Pad, physical memory gets fragmented after some hours
of use (e.g. a browser playing videos). Then no order-5 block is left,
the allocation fails ("Allocate new vcu queue fail!"), vdec_init()
returns -1 and every new video fails to decode until a reboot.
Compaction and drop_caches do not help, because the free memory is
split across pageblocks that contain unmovable kernel allocations.

The queue is only bookkeeping for the CPU and is never accessed by
hardware, so it does not need to be physically contiguous. Use
kvzalloc()/kvfree(), which fall back to vmalloc when no contiguous
block is available.
---
 drivers/media/platform/mtk-vcu/mtk_vcodec_mem.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/drivers/media/platform/mtk-vcu/mtk_vcodec_mem.c b/drivers/media/platform/mtk-vcu/mtk_vcodec_mem.c
index 64e63618a..e01c1ae9d 100644
--- a/drivers/media/platform/mtk-vcu/mtk_vcodec_mem.c
+++ b/drivers/media/platform/mtk-vcu/mtk_vcodec_mem.c
@@ -5,6 +5,7 @@
  */
 
 #include <linux/dma-heap.h>
+#include <linux/mm.h>
 #include <uapi/linux/dma-heap.h>
 #include "mtk_heap.h"
 #include "mtk_vcodec_mem.h"
@@ -24,7 +25,7 @@ struct mtk_vcu_queue *mtk_vcu_mem_init(struct device *dev,
 {
 	struct mtk_vcu_queue *vcu_queue = NULL;
 
-	vcu_queue = kzalloc(sizeof(struct mtk_vcu_queue), GFP_KERNEL);
+	vcu_queue = kvzalloc(sizeof(struct mtk_vcu_queue), GFP_KERNEL);
 	if (vcu_queue == NULL) {
 		pr_info("Allocate new vcu queue fail!\n");
 		return NULL;
@@ -94,7 +95,7 @@ void mtk_vcu_mem_release(struct mtk_vcu_queue *vcu_queue)
 		kfree(tmp);
 	}
 	mutex_unlock(&vcu_queue->mmap_lock);
-	kfree(vcu_queue);
+	kvfree(vcu_queue);
 	vcu_queue = NULL;
 }
 
-- 
2.47.3

